[Unit]
Description=ArQmA pool: payment processor (sendmany from the pool wallet; emergency brake: deployment/pause-payments.sh)
After=arq-pool-redis.service arq-node.service arq-wallet-rpc.service
Requires=arq-pool-redis.service
[Service]
Type=simple
User=arqpool
WorkingDirectory=/opt/arqma-nodejs-pool
ExecStart=/usr/bin/node /opt/arqma-nodejs-pool/init.js -module=payments
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
