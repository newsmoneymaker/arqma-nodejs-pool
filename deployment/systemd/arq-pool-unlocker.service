[Unit]
Description=ArQmA pool: block unlocker (credits the miners after the coinbase maturity)
After=arq-pool-redis.service arq-node.service arq-wallet-rpc.service
Requires=arq-pool-redis.service
[Service]
Type=simple
User=arqpool
WorkingDirectory=/opt/arqma-nodejs-pool
ExecStart=/usr/bin/node /opt/arqma-nodejs-pool/init.js -module=unlocker
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
