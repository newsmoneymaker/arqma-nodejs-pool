[Unit]
Description=ArQmA pool: stratum server (miners, share checking with the rxhash helper, block submission)
After=arq-pool-redis.service arq-node.service arq-wallet-rpc.service
Requires=arq-pool-redis.service
[Service]
Type=simple
User=arqpool
WorkingDirectory=/opt/arqma-nodejs-pool
ExecStart=/usr/bin/node /opt/arqma-nodejs-pool/init.js -module=pool
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
# ports below 1024 need this:
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
