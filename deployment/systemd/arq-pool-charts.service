[Unit]
Description=ArQmA pool: charts data collector (hash rate, difficulty, miners, workers on the home page)
After=arq-pool-redis.service arq-pool-api.service
Requires=arq-pool-redis.service
[Service]
Type=simple
User=arqpool
WorkingDirectory=/opt/arqma-nodejs-pool
ExecStart=/usr/bin/node /opt/arqma-nodejs-pool/init.js -module=chartsDataCollector
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
